#!/usr/bin/env bash
# Symlink each skill dir from this repo into ~/.claude/skills/.
# Safe to re-run.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_DIR="$HOME/.claude/skills"

mkdir -p "$TARGET_DIR"

for skill in feature feature-requirements feature-plan feature-implement \
             feature-context feature-review feature-iterate feature-qa; do
    src="$REPO_DIR/$skill"
    dst="$TARGET_DIR/$skill"

    if [[ ! -d "$src" ]]; then
        echo "skip: $skill (not in repo)" >&2
        continue
    fi

    # Remove any existing target (real dir, broken symlink, or correct symlink)
    if [[ -e "$dst" || -L "$dst" ]]; then
        rm -rf "$dst"
    fi

    ln -s "$src" "$dst"
    echo "linked: $skill"
done

echo "done."
