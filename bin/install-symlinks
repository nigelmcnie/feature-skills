#!/usr/bin/env bash
# Symlink each skill dir from this repo into ~/.claude/skills/, and
# symlink the export script into ~/.local/bin/ so skills can invoke
# `feature-html-to-md` without hardcoding repo paths.
# Safe to re-run.
set -euo pipefail

REPO_DIR="$(dirname "$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --path-format=absolute --git-common-dir)")"
SKILLS_DIR="$HOME/.claude/skills"
BIN_DIR="$HOME/.local/bin"

mkdir -p "$SKILLS_DIR" "$BIN_DIR"

for skill in feature feature-requirements feature-plan feature-implement \
             feature-context feature-choice feature-review feature-iterate \
             feature-qa feature-retro; do
    src="$REPO_DIR/$skill"
    dst="$SKILLS_DIR/$skill"

    if [[ ! -d "$src" ]]; then
        echo "skip: $skill (not in repo)" >&2
        continue
    fi

    # Remove any existing target (real dir, broken symlink, or correct symlink)
    if [[ -e "$dst" || -L "$dst" ]]; then
        rm -rf "$dst"
    fi

    ln -s "$src" "$dst"
    echo "linked skill: $skill"
done

# Bin scripts. Each must be executable in the repo.
for script in feature-html-to-md doc-contract-lint; do
    src="$REPO_DIR/bin/$script"
    dst="$BIN_DIR/$script"

    if [[ ! -f "$src" ]]; then
        echo "skip: $script (not in repo)" >&2
        continue
    fi

    if [[ -e "$dst" || -L "$dst" ]]; then
        rm -f "$dst"
    fi

    ln -s "$src" "$dst"
    echo "linked bin: $script -> $dst"
done

echo "done."
